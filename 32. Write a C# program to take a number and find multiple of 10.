// 32. Write a C# program to take a number from the user and check whether it is a multiple of 10.
using System;
namespace first
{
	class first
	{
		static void Main(string[] args)
		{
			Console.WriteLine("Enter a number: ");
			double num = Convert.ToInt32(Console.ReadLine());
			if(num%10==0)
			{
				Console.WriteLine($"{num} is multiple of 10");
			}
			else
			{
				Console.WriteLine($"{num} is NOT multiple of 10.");
			}
		}
	}
}
