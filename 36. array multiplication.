// 36. array multiplication.

using System;
class Program
{
    static void Main()
    {
        // 1. Create two lists of numbers (arrays)
        int[] firstArray = { 1, 3, 5 };
        int[] secondArray = { 2, 4, 6 };

        // 2. Create a third array to hold the answers
        int[] resultArray = new int[firstArray.Length];

        // 3. Loop through the items and multiply them one by one
        for (int i = 0; i < firstArray.Length; i++)
        {
            resultArray[i] = firstArray[i] * secondArray[i];
        }
        // 4. Print the final answer
        Console.WriteLine("Result: " + string.Join(", ", resultArray));
    }
}
