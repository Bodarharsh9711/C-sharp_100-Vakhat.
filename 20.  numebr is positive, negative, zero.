// 20.  check entered number is positive, negative, or zero.

using System;
namespace first
{
	class first{
		static void Main(string[] args)
		{
			Console.WriteLine("Enter your First number: ");
			Double a  = Convert.ToInt32(Console.ReadLine());
			if(a>0){
				Console.WriteLine("your number is positive: "+a);
			}
			else if(a==0){
				Console.WriteLine("you number is ZERO: "+a);
			}
           	else{
				Console.WriteLine("your number is negative: "+a);
			}		
			Console.WriteLine("WOW");
		}
	}
} 
