// 4. take 2 variable and perform BODMAS.

using System;
public class HelloWorld
{
    public static void Main(string[] args)
    {
        float math_mark = 10;
        float computer_mark = 10; 
        float sum = math_mark + computer_mark;
        float quotient = math_mark / computer_mark;
        float product = math_mark * computer_mark;
        float difference = math_mark - computer_mark;

        Console.WriteLine("the sum is: "+sum);   // easy way.
        Console.WriteLine($"The sum is: {sum}"); // professional way.
        Console.WriteLine($"The quotient is: {quotient}");
        Console.WriteLine($"The product is: {product}");
        Console.WriteLine($"The difference is: {difference}");
    }
}
