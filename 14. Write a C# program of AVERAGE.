// 14. Write a C# program to take two numbers from the user and print their sum.

using System;
namespace first
{
	class first{
		static void Main(string[] args)
		{
			Console.WriteLine("Enter your frist value: ");
			double a = Convert.ToInt32(Console.ReadLine());
			Console.WriteLine("Enter your second value: ");
			double b = Convert.ToInt32(Console.ReadLine());
			Console.WriteLine("Enter your third value: ");
			double c = Convert.ToInt32(Console.ReadLine());

			double d = (a+b+c)/3;
			Console.WriteLine("So, your sum is: "+d);
		}
	}
} 
