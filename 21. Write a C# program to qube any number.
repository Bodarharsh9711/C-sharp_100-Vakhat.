// 21. Write a C# program to take a number from the user and calculate its cube.

using System;
namespace first
{
	class first
	{
		static void Main(string[] args)
		{
			Console.WriteLine("Enter your number for cube");
			Double a  = Convert.ToInt32(Console.ReadLine());
		
			a = a*a*a;
			Console.WriteLine("your cube is: "+a);
		}
	}
}
